programa EX3
procesos
  proceso juntarFlores (ES f: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      f:= f + 1
  fin
  
  proceso depositarFlores (E f: numero)
  comenzar
    repetir f
      depositarFlor
  fin
  
  proceso avanzarRecolectando
  variables
    flores: numero
    AvActual, CaActual: numero
    movimientos: numero
  comenzar
    movimientos:= 0
    mientras ((movimientos < 15) & (flores < 10) & (PosAv < 100))
      juntarFlores(flores)
      si(flores < 10)
        si(PosAv< 100)
          mover
          movimientos:= 1
      si(PosAv = 100)
        si (flores < 10)
          juntarFlores(flores)
    AvActual:= PosAv
    CaActual:= PosCa
    BloquearEsquina(10,10)
    Pos(10,10)
    depositarFlores(flores)
    Pos(AvActual, CaActual)
    LiberarEsquina(10,10)
  fin
areas
  a1: AreaP (1,3,100,3)
  a2: AreaP (1, 4, 100, 4)
  aj: AreaP (1, 5, 1, 5)
  esquina: AreaC (10,10,10,10)
robots
  robot recolector
  comenzar
    derecha
    mientras(PosAv < 100)
      avanzarRecolectando
      EnviarMensaje(1, c)
    EnviarMensaje(0, c)
  fin
  robot cosechador
  variables
    totalF: numero
    terminaron: numero
    aviso: numero
    AvActual, CaActual: numero
  comenzar
    terminaron:= 0
    totalF:= 0
    AvActual:= PosAv
    CaActual:= PosCa
    mientras (terminaron < 2)
      RecibirMensaje(aviso, *)
      si(aviso = 1)
        BloquearEsquina(10,10)
        Pos(10,10)
        juntarFlores(totalF)
        Pos(AvActual, CaActual)
        LiberarEsquina(10,10)  
      sino
        terminaron:= terminaron + 1
    Informar(totalF)
  fin
variables
  r1, r2: recolector
  c: cosechador
comenzar
  AsignarArea(r1, a1)
  AsignarArea(r1, esquina)
  AsignarArea(r2, a2)
  AsignarArea(r2, esquina)
  AsignarArea(c, aj)
  AsignarArea(c, esquina)
  Iniciar(r1, 1,3)
  Iniciar(r2, 1, 4)
  Iniciar(c, 1,5)
fin