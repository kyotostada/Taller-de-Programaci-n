{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ejemplo
procesos
  proceso recogerFlor (ES f: numero)
  comenzar
    si(HayFlorEnLaEsquina)
      tomarFlor
      f:= f + 1
  fin
  proceso recorrerAvenida (ES flores: numero)
  variables
    ide, flores: numero
  comenzar
    flores:= 0
    RecibirMensaje(ide, jefe)
    repetir 9
      recogerFlor(flores)
      mover
    recogerFlor(flores)
    EnviarMensaje(ide, jefe)
    EnviarMensaje(flores, jefe)
  fin
areas
  a1: AreaP (1,1,1,10)
  a2: AreaP (2, 11, 2, 20)
  aj: AreaP(3, 1, 3, 10)
robots
  robot coordinador
  variables
    otro, diferencia, quien, cant, robotMax, max: numero
  comenzar
    max:= 0
    otro: 0
    EnviarMensaje(1, r1)
    EnviarMensaje(2, r2)
    
    repetir 2
      RecibirMensaje(quien, *)
      si(quien = 1)
        RecibirMensaje(cant, r1)
      sino
        RecibirMensaje(cant, r2)
      si (cant >= max)
        otro:= max
        robotMax:= quien
        max:= cant
      diferencia:= max - otro
    Informar(diferencia)
  fin
  robot competidor
  variables
    flo: numero
  comenzar
    recorrerAvenida(flo)
  fin
variables
  r1: competidor
  r2: competidor
  jefe: coordinador
comenzar
  AsignarArea(r1, a1)
  AsignarArea(r2, a2)
  AsignarArea(jefe, aj)
  Iniciar(r1, 1, 1)
  Iniciar(r2, 2, 11)
  Iniciar(jefe, 3, 1)
fin
