programa EX5
procesos
  proceso juntarPapel(ES ok: boolean)
  comenzar
    si(HayPapelEnLaEsquina)
      tomarPapel
    sino
      ok:= F
  fin
  
  proceso calcularMaximo(E id: numero; ES robotMax: numero; ES max: numero; E calle: numero)
  comenzar
    si(max < calle)
      max:= calle
      robotMax:= id
  fin
  
  proceso EnviarIDs
  comenzar
    EnviarMensaje(1, r1)
    EnviarMensaje(2, r2)
    EnviarMensaje(3, r3)
    EnviarMensaje(4, r4)
  fin
  
  proceso EnviarEsquina
  comenzar
    EnviarMensaje(11, r1)
    EnviarMensaje(11, r2)
    EnviarMensaje(11, r3)
    EnviarMensaje(11, r4)
  fin
areas
  fuente: AreaPC(11,11,11,11)
  a1: AreaP (4,1,4,100)
  a2: AreaP (6, 1, 6, 100)
  a3: AreaP (8, 1, 8, 100)
  a4: AreaP (10, 1, 10, 100)
  aj: AreaP(1, 1, 1, 1)
  
robots
  robot corredor
  variables
    AvActual, CaActual: numero
    id: numero
    papeles: numero
    ok: boolean
    esquina: numero
  comenzar
    RecibirMensaje (id, jefe)
    RecibirMensaje(esquina, jefe)
    ok:= V
    mientras(ok) & (PosCa < 100)
      AvActual:= PosAv
      CaActual:= PosCa
      BloquearEsquina(esquina, esquina)
      Pos(esquina, esquina)
      juntarPapel(ok)
      Pos(AvActual, CaActual)
      LiberarEsquina(esquina, esquina)
      si(ok)
        depositarPapel
        mover
    EnviarMensaje(id, jefe)
    EnviarMensaje(CaActual, jefe)
  fin
  robot coordinador
  variables
    id: numero
    max, robotMax, calle: numero
  comenzar
    max:= -1
    EnviarIDs
    EnviarEsquina
    repetir 4
      RecibirMensaje(id, *)
      si (id = 1)
        RecibirMensaje(calle, r1)
      sino
        si (id = 2)
          RecibirMensaje(calle, r2)
        sino
          si(id = 3)
            RecibirMensaje(calle, r3)
          sino
            RecibirMensaje(calle, r4)
      calcularMaximo(id, robotMax, max, calle)
    Informar(robotMax)
  fin
variables
  r1, r2, r3, r4: corredor
  jefe: coordinador
comenzar
  AsignarArea(r1, a1)
  AsignarArea(r2, a2)
  AsignarArea(r3, a3)
  AsignarArea(r4, a4)
  AsignarArea(jefe, aj)
  AsignarArea(r1, fuente)
  AsignarArea(r2, fuente)
  AsignarArea(r3, fuente)
  AsignarArea(r4, fuente)
  Iniciar(r1, 4, 1)
  Iniciar(r2, 6, 1)
  Iniciar(r3, 8, 1)
  Iniciar(r4, 10, 1)
  Iniciar(jefe, 1, 1)
fin

