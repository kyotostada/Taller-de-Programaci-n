{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ejemplo

procesos

  proceso juntarPapel (ES p: numero)
  comenzar
    si(HayPapelEnLaEsquina)
      mientras(HayPapelEnLaEsquina)
        tomarPapel
        p:= p + 1
  fin
  
  proceso recorrerCalle(ES papeles: numero)
  comenzar
    derecha
    repetir 9
      juntarPapel(papeles)
      mover
    juntarPapel(papeles)
  fin
  proceso EnviarIDs
  comenzar
    EnviarMensaje(1, a2)
    EnviarMensaje(2, b2)
  fin
    
areas
  area1: AreaP (1, 5, 10, 5)
  area2: AreaP (11, 5, 20, 5)
  area3: AreaP (1, 7, 10, 7)
  area4: AreaP (11, 7, 20, 7)
  aj: AreaP(1,1,1,1)

robots
  robot primero
  variables
    final: boolean
    ide, papeles: numero
  comenzar
    RecibirMensaje(ide, coordinador)
    papeles:= 0
    recorrerCalle(papeles)
    final:= V
    si (ide = 1)
      EnviarMensaje(final, a2)
      EnviarMensaje(papeles, a2)
    sino
      EnviarMensaje(final, b2)
      EnviarMensaje(papeles, a2)
  fin

  robot segundo
  variables
    inicio: boolean
    ide, papeles: numero
  comenzar
    RecibirMensaje(ide, jefe)
    si(ide = 1)
      RecibirMensaje(inicio, a1)
      RecibirMensaje(papeles, a1)
    sino
      si(ide = 2)
        RecibirMensaje(inicio, b1)
        RecibirMensaje(papeles, b1)
    si(inicio)  
      recorrerCalle(papeles)
      EnviarMensaje(ide, jefe)
      EnviarMensaje(papeles, jefe)
  fin
  robot coordinador
  variables
    quien, primero, segundo, equipoganador: numero
  comenzar
    primero:= -1
    EnviarIDs
    repetir 2
      RecibirMensaje(quien, *)
      si(quien = 1) & (primero < 0)
        RecibirMensaje(primero, a2)
      sino
        si(quien = 1)
          RecibirMensaje(segundo, a2)
        sino
          si(quien = 2) and (primero < 0)
            RecibirMensaje(primero, b2)
          sino
            si(quien = 2)
              RecibirMensaje(cant2, b2)
    Informar(primero)
