{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ejemplo
procesos
  proceso recogerFlor (ES f: numero)
  comenzar
    si(HayFlorEnLaEsquina)
      mientras(HayFlorEnLaEsquina)
        tomarFlor
        f:= f + 1
  fin
  proceso recorrerAvenida (ES flores: numero)
  variables
    otro, flores: numero
  comenzar
    flores:= 0
    repetir 9
      recogerFlor(flores)
      mover
    recogerFlor(flores)
  fin
areas
  a1: AreaP (1,1,1,10)
  a2: AreaP (2, 11, 2, 20)
robots
  robot competidor1
  variables
    diferencia, otro, flo: numero
  comenzar
    recorrerAvenida(flo)
    EnviarMensaje(flo, r2)
    RecibirMensaje(otro, r2)
    si(flo > otro)
      diferencia:= flo - otro
      Informar(diferencia)
  fin
  robot competidor2
  variables
    diferencia, otro, flo: numero
  comenzar
    recorrerAvenida(flo)
    EnviarMensaje(flo, r1)
    RecibirMensaje(otro, r1)
    si(flo > otro)
      diferencia:= flo - otro
      Informar(diferencia)
  fin
variables
  r1: competidor1
  r2: competidor2
comenzar
  AsignarArea(r1, a1)
  AsignarArea(r2, a2)
  Iniciar(r1, 1, 1)
  Iniciar(r2, 2, 11)
fin