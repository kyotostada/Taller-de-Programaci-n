{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ejemplo
procesos
  proceso juntarPapeles(ES papeles: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      papeles:= papeles + 1
  fin
  proceso depositarPapeles (E papeles: numero)
  comenzar
    repetir papeles
      depositarPapel
  fin
  proceso depositarFlores (E flores: numero)
  comenzar
    repetir flores
      depositarFlor
  fin
  proceso juntarFlores(ES flores: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      flores:= flores + 1
  fin
  proceso recorrerCalle(E esquinas: numero)
  variables
    flores: numero
  comenzar
    flores:= 0
    repetir esquinas - 1
      juntarFlores(flores)
      mover
    juntarFlores(flores)
    depositarFlores(flores)
  fin
  proceso recorrerAvenida(E esquinas: numero; E avenida: numero; E calledeposito: numero)
  variables
    papeles: numero
  comenzar
    papeles:= 0
    repetir esquinas - 1
      juntarPapeles(papeles)
      mover
    juntarPapeles(papeles)
    Pos(avenida, calledeposito)
    depositarPapeles(papeles)
  fin
areas
  a1: AreaP (1,75,15,80)
  a2: AreaP (75, 81, 80, 100)
  a3: AreaP (71, 10, 100, 15)
  a4: AreaP (10, 1, 15, 10)
robots
  robot robot1
  comenzar
    derecha
    recorrerCalle(15)
    Pos(1, 80)
    recorrerCalle(15)
  fin
  robot robot2
  comenzar
    recorrerAvenida(20, 75, 81)
    Pos(80, 81)
    recorrerAvenida(20, 80, 81)
  fin
  robot robot3
  comenzar
    derecha
    recorrerCalle(30)
    Pos(71, 10)
    recorrerCalle(30)
  fin
  robot robot4
  comenzar
    recorrerAvenida(10, 10, 1)
    Pos(15, 1)
    recorrerAvenida(10, 15, 1)
  fin
variables
  r1: robot1
