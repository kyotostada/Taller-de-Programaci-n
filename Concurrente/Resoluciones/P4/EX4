programa EX4
procesos
  proceso recogerFlores
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
  fin
  
  proceso recogerPapeles
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
  fin
  
  proceso EnviarOrdenes (E e: numero; E t: numero; E a: numero; E c: numero)
  comenzar
    si(e=1)
      EnviarMensaje(t, r1)
      EnviarMensaje(a, r1)
      EnviarMensaje(c, r1)
    sino
      EnviarMensaje(t, r2)
      EnviarMensaje(a, r2)
      EnviarMensaje(c, r2)
  fin
  proceso EnviarFin
  comenzar
    EnviarMensaje(4, r1)
    EnviarMensaje(4, r2)
  fin
  proceso vaciarBolsa 
  comenzar
    mientras(HayFlorEnLaBolsa)
      depositarFlor
    mientras(HayPapelEnLaBolsa)
      depositarPapel
  fin
  
areas
  zonatrabajo: AreaPC(2,2,100,100)
  a1: AreaP(2,1,2,1)
  a2: AreaP(3,1,3,1)
  aj: AreaP(1,1,1,1)
robots
  robot jefe
  variables
    tarea: numero
    Av, Ca: numero
    empleado: numero
  comenzar
    repetir 10
      Random(empleado, 1, 2)
      Random(tarea, 1,3)
      Random(Av, 2, 100)
      Random(Ca, 2, 100)
      EnviarOrdenes(empleado, tarea, Av, Ca)
    EnviarFin
  fin
  robot trabajador
  variables
    Av, AvInicial, CaInicial, Ca: numero
    tarea: numero
  comenzar
    AvInicial:= PosAv
    CaInicial:= PosCa
    RecibirMensaje(tarea, rj)
    mientras(tarea <> 4)
      RecibirMensaje(Av, rj)
      RecibirMensaje(Ca, rj)
      BloquearEsquina(Av, Ca)
      Pos(Av, Ca)
      si(tarea = 1)
        recogerFlores
      sino
        si(tarea = 2)
          recogerPapeles
        sino
          vaciarBolsa
      Pos(AvInicial, CaInicial)
      LiberarEsquina(Av, Ca)
      RecibirMensaje(tarea, rj)
  fin
    
variables
  r1, r2: trabajador
  rj: jefe
comenzar
  AsignarArea(r1, a1)
  AsignarArea(r2, a2)
  AsignarArea(r1, zonatrabajo)
  AsignarArea(r2, zonatrabajo)
  AsignarArea(rj, aj)
  Iniciar(rj, 1,1)
  Iniciar(r1, 2,1)
  Iniciar(r2, 3,1)
fin

{Lo que entendí del ejercicio:
Para el master:
Envía ID a los dos trabajadores
Envía 10 tareas, asignadas aleatoriamente, a los dos trabajadores
Envía esquina, asignada aleatoriamente, a los dos trabajadores
Envia orden de terminar pasadas las 10 tareas

Para el slave:
Recibe su id
Recibe su tarea
Recibe la esquina donde debe hacer su tarea
Esperan a la nueva tarea}


