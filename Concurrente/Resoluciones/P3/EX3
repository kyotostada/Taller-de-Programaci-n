programa EX3
procesos
  proceso juntarFlor(ES f: numero; ES ok: boolean)
  comenzar
    si(HayFlorEnLaEsquina)
      tomarFlor
      f:= f+ 1
    sino
      ok:= F
  fin
  proceso EnviarIDs
  comenzar
    EnviarMensaje(1, r1)
    EnviarMensaje(2, r2)
    EnviarMensaje(3, r3)
    EnviarMensaje(4, r4)
  fin
  
  proceso enviarEsquina (E av: numero; E ca: numero)
  comenzar
    EnviarMensaje(av, r1)
    EnviarMensaje(ca, r1)
    EnviarMensaje(av, r2)
    EnviarMensaje(ca, r2)
    EnviarMensaje(av, r3)
    EnviarMensaje(ca, r3)
    EnviarMensaje(av, r4)
    EnviarMensaje(ca, r4)
  fin
  
  proceso CalcularMax(E id: numero; ES f: numero; ES max: numero; ES robotMax: numero)
  comenzar
    si(f > max)
      max:= f
      robotMax:= id
  fin
  
areas
  cuadrante: AreaPC(2,2,10,10)
  a1: AreaP (2,1,2,1)
  a2: AreaP (3,1,3,1)
  a3: AreaP (4,1,4,1)
  a4: AreaP(5,1,5,1)
  aj: AreaP(1,1,1,1)
robots
  robot recolector
  variables
    AvIn, CaIn, Av, Ca: numero
    flores: numero
    id: numero
    hay: boolean
  comenzar
    flores:= 0
    hay:= V
    AvIn:= PosAv
    CaIn:= PosCa
    RecibirMensaje(id, jefe)
    RecibirMensaje(Av, jefe)
    RecibirMensaje(Ca, jefe)
    mientras(hay)
      BloquearEsquina(Av, Ca)
      Pos(Av,Ca)
      juntarFlor(flores, hay)
      Pos(AvIn, CaIn)
      LiberarEsquina(Av, Ca)
    EnviarMensaje(id, jefe)
    EnviarMensaje(flores, jefe)
  fin
  robot coordinador
  variables
    av, ca: numero
    id, max, robotMax: numero
    flores: numero
  comenzar
    max:= -1
    Random(av, 2,10)
    Random(ca, 2,10)
    EnviarIDs
    enviarEsquina(av, ca)
    repetir 4
      RecibirMensaje(id, *)
      si(id = 1)
        RecibirMensaje(flores, r1)
      sino
        si(id = 2)
          RecibirMensaje(flores, r2)
        sino
          si (id = 3)
            RecibirMensaje(flores, r3)
          sino
            RecibirMensaje(flores, r4)
      CalcularMax(id, flores, max, robotMax)
    Informar(robotMax)
  fin
variables
  r1, r2, r3, r4: recolector
  jefe: coordinador
comenzar
  AsignarArea(r1, cuadrante)
  AsignarArea(r1, a1)
  AsignarArea(r2, cuadrante)
  AsignarArea(r2, a2)
  AsignarArea(r3, cuadrante)
  AsignarArea(r3, a3)
  AsignarArea(r4, cuadrante)
  AsignarArea(r4, a4)
  AsignarArea(jefe, aj)
  Iniciar(r1, 2,1)
  Iniciar(r2,3,1)
  Iniciar(r3,4,1)
  Iniciar(r4,5,1)
  Iniciar(jefe, 1,1)
fin