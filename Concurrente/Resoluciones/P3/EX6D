{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa EX6
procesos
  proceso juntarFlores (ES f: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      f:= f + 1
  fin
  proceso juntarPapeles(ES p: numero)
  comenzar
    mientras(HayPapelEnLaEsquina)
      tomarPapel
      p:= p + 1
  fin
  
  proceso MoverYBloquear (E id: numero)
  comenzar
    si(id = 1)
      si((PosAv = 4) & (PosCa = 7))
        BloquearEsquina(5, 7)
      si((PosAv = 7) & (PosCa = 6))
        BloquearEsquina(7,5)
    sino
      si((PosAv = 5) & (PosCa = 6))
        BloquearEsquina(5, 7)
      si((PosAv = 8) & (PosCa = 5))
        BloquearEsquina(7,5)
    mover
    si (id = 1)
      si((PosAv = 6) & (PosCa = 7))
        LiberarEsquina(5, 7)
      si((PosAv = 7) & (PosCa = 4))
        LiberarEsquina(7,5)
    sino
      si((PosAv = 5) & (PosCa = 8))
        LiberarEsquina(5, 7)
      si((PosAv = 6) & (PosCa = 5))
        LiberarEsquina(7,5) 
  fin                    
    
  proceso cuadranteRobot1 (ES flores: numero; E id: numero)
  comenzar
    repetir 4
      repetir 5
        juntarFlores(flores)
        MoverYBloquear(id)
      derecha
  fin
  
  proceso cuadranteRobot2 (ES flores: numero; ES papeles: numero; E id: numero)
  comenzar
    repetir 4
      repetir 9
        juntarPapeles(papeles)
        juntarFlores(flores)
        MoverYBloquear(id)
      derecha
  fin
  
areas
  deposito: AreaPC(1,20,100,21)
  cuadrante: AreaPC(2,2,14,14)
  aj: AreaP (1,1,1,1)
robots
  robot robot1
  variables
    calle: numero
    id, flores: numero
    listo: boolean
  comenzar
    flores:= 0
    RecibirMensaje(id, jefe)
    cuadranteRobot1(flores, id)
    EnviarMensaje(id, jefe)
    RecibirMensaje(calle, jefe)
    Pos(1, calle)
    mientras(HayFlorEnLaBolsa) & (PosAv < 100)
      depositarPapel
      mover
    listo:= V
    EnviarMensaje(listo, jefe)
  fin
  robot robot2
  variables
    calle: numero
    id: numero
    flores, papeles: numero
    listo: boolean
  comenzar
    flores:= 0
    papeles:= 0
    RecibirMensaje(id, jefe)
    cuadranteRobot2(flores, papeles, id)
    EnviarMensaje(id, jefe)
    RecibirMensaje(calle, jefe)
    Pos(1, calle)
    mientras(HayFlorEnLaBolsa) & (PosCa < 100)
      depositarFlor
      depositarPapel
      mover
    listo:= V
    EnviarMensaje(listo, jefe)
  fin
  robot coordinador
  variables
    id: numero
    primero, segundo: numero
  comenzar
    EnviarMensaje (1, r1)
    EnviarMensaje (2, r2)
    RecibirMensaje(primero, *)
    RecibirMensaje(segundo, *)
    si (primero = 1)
      EnviarMensaje(20, r1)
      EnviarMensaje(21, r2)
    sino
      EnviarMensaje(20, r2)
      EnviarMensaje(21, r1)
  fin
variables
  r1: robot1
  r2: robot2
  jefe: coordinador
comenzar
  AsignarArea(r1, cuadrante)
  AsignarArea(r2, cuadrante)
  AsignarArea(r1, deposito)
  AsignarArea(r2, deposito)
  AsignarArea(jefe, aj)
  Iniciar(r1, 2,2)
  Iniciar(r2, 5,5)
  Iniciar(jefe, 1,1)
fin