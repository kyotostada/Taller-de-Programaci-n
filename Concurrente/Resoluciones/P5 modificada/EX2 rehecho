programa EX2
procesos
  proceso vaciarEsquina (ES f: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      f:= f + 1
    mientras(HayPapelEnLaEsquina)
      tomarPapel
  fin
  
  proceso depositarFlores (E f: numero)
  comenzar
    repetir f
      depositarFlor
  fin
  
  proceso juntarFlores (ES f: numero)
  comenzar
    mientras(HayFlorEnLaEsquina)
      tomarFlor
      f:= f + 1
  fin
  
  proceso EnviarIDs
  comenzar
    EnviarMensaje(1, r1)
    EnviarMensaje(2, r2)
    EnviarMensaje(3, r3)
  fin
  proceso avanzarEtapa (E f: numero)
  variables
    Av, Ca: numero
  comenzar
    repetir 9
      vaciarEsquina (f)
      mover
    Av:= PosAv
    Ca:= PosCa  
    BloquearEsquina(50, 50)
    Pos(50,50)
    depositarFlores(f)
    Pos(Av, Ca)
    LiberarEsquina(50,50)
  fin
  proceso barrera (E id: numero)
  variables
    aviso: boolean
  comenzar
    si (id = 1)
      EnviarMensaje(V, r2)
      EnviarMensaje(V, r3)
    sino
      si (id = 2)
        EnviarMensaje (V, r1)
        EnviarMensaje(V, r3)
      sino
        EnviarMensaje(V, r1)
        EnviarMensaje(V, r2)
    repetir 2
      RecibirMensaje(aviso, *)
  fin
  
areas
  a1: AreaP (1,1,100,1)
  a2: AreaP (1, 2, 100, 2)
  a3: AreaP (1, 3, 100, 3)
  aj: AreaP (1, 4, 1, 4)
  esquina: AreaC (50, 50, 50, 50)
robots
  robot recolector
  variables
    flores: numero
    id: numero
  comenzar
    RecibirMensaje(id, jefe)
    derecha
    flores:= 0
    mientras(PosAv < 100)
      avanzarEtapa(flores)
      barrera(id)
    EnviarMensaje(id, jefe)
  fin
  
  robot coordinador
  variables
    id: numero
    terminaron: numero
    flores: numero
  comenzar
    EnviarIDs
    flores:= 0
    repetir 3
      RecibirMensaje(id, *)
    Pos(50,50)
    juntarFlores(flores)
    Informar(flores)
  fin
variables
  r1, r2, r3: recolector
  jefe: coordinador
comenzar
  AsignarArea(r1, a1)
  AsignarArea(r1, esquina)
  AsignarArea(r2, a2)
  AsignarArea(r2, esquina)
  AsignarArea(r3, a3)
  AsignarArea(r3, esquina)
  AsignarArea(jefe, aj)
  AsignarArea(jefe, esquina)
  Iniciar(r1, 1,1)
  Iniciar(r2, 1,2)
  Iniciar(r3, 1,3)
  Iniciar(jefe, 1,4)
fin
