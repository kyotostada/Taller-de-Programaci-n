{Bienvenidos al entorno CMRE.
Lo siguiente es un código de ejemplo que implementa un
proceso que recibe un número de avenida como parámetro,
se posiciona en esa avenida y la recorre.}

programa ejemplo

procesos

  proceso juntarPapel (ES p: numero)
  comenzar
    si(HayPapelEnLaEsquina)
      mientras(HayPapelEnLaEsquina)
        tomarPapel
        p:= p + 1
  fin
  
  proceso recorrerCalle(ES papeles: numero)
  comenzar
    repetir 9
      juntarPapel(papeles)
      mover
    juntarPapel(papeles)
  fin
  proceso EnviarIDs
  comenzar
    EnviarMensaje(1, a1)
    EnviarMensaje(1, a2)
    EnviarMensaje(2, b1)
    EnviarMensaje(2, b2)
  fin
    
areas
  area1a: AreaP (1, 5, 10, 5)
  area1b: AreaP (11, 5, 20, 5)
  area1c: AreaP(21, 5, 30, 5)
  area1d: AreaP(31, 5, 40, 5)
  area2a: AreaP (1, 7, 10, 7)
  area2b: AreaP (11, 7, 20, 7)
  area2c: AreaP (21, 7, 30, 7)
  area2d: AreaP (31, 7, 40, 7)
  aj: AreaP(1,1,1,1)

robots
  robot primero
  variables
    final: boolean
    ide, papeles: numero
  comenzar
    derecha
    RecibirMensaje(ide, jefe)
    papeles:= 0
    recorrerCalle(papeles)
    final:= V
    si (ide = 1)
      EnviarMensaje(final, a2)
      EnviarMensaje(papeles, a2)
    sino
      EnviarMensaje(final, b2)
      EnviarMensaje(papeles, b2)
    Pos(21, PosCa)
    recorrerCalle(papeles)
    final:= V
    si (ide = 1)
      EnviarMensaje(final, a2)
      EnviarMensaje(papeles, a2)
    sino
      EnviarMensaje(final, b2)
      EnviarMensaje(papeles, b2)
  fin

  robot segundo
  variables
    inicio: boolean
    ide, papeles: numero
  comenzar
    derecha
    RecibirMensaje(ide, jefe)
    si (ide = 1)
      RecibirMensaje(inicio, a1)
      RecibirMensaje(papeles, a1)
    sino
      si (ide = 2)
        RecibirMensaje(inicio, b1)
        RecibirMensaje(papeles, b1)
    si(inicio)  
      recorrerCalle(papeles)
      EnviarMensaje(ide, jefe)
      EnviarMensaje(papeles, jefe)
    Pos(31, PosCa)
    si(ide = 1)
      RecibirMensaje(inicio, a1)
      RecibirMensaje(papeles, a1)
    sino
      si(ide = 2)
        RecibirMensaje(inicio, b1)
        RecibirMensaje(papeles, b1)
    si(inicio)  
      recorrerCalle(papeles)
      EnviarMensaje(ide, jefe)
      EnviarMensaje(papeles, jefe)
    
  fin
  robot coordinador
  variables
    quien, campeon, subcampeon, equipoganador: numero
  comenzar
    EnviarIDs
    RecibirMensaje(campeon, *)
    RecibirMensaje(subcampeon, *)
    Informar(campeon)
  fin
variables
  a1, b1: primero
  a2, b2: segundo
  jefe: coordinador
comenzar
  AsignarArea(a1, area1a)
  AsignarArea(a1, area1c)
  AsignarArea(a2, area1b)
  AsignarArea(a2, area1d)
  AsignarArea(b1, area2a)
  AsignarArea(b1, area2c)
  AsignarArea(b2, area2b)
  AsignarArea(b2, area2d)
  AsignarArea(jefe, aj)
  Iniciar(a1, 1,5)
  Iniciar(a2, 11, 5)
  Iniciar(b1, 1, 7)
  Iniciar(b2, 11, 7)
  Iniciar(jefe, 1,1)
fin